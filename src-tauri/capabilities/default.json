{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",

    "store:allow-load",
    "store:allow-save",
    "store:allow-get",
    "store:allow-set",
    "store:allow-has",
    "store:allow-delete",
    "store:allow-keys",
    "store:allow-entries",
    "store:allow-length",
    "store:allow-values",
    "store:allow-clear",

    "dialog:allow-open",
    "dialog:default",

    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",

    "process:allow-restart",
    "process:allow-exit"
  ]
}
